rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTodoList(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 16 &&
             data.isLocked is bool &&
             data.isShared is bool &&
             data.driveFileId is string && data.driveFileId.size() <= 200 &&
             data.ownerEmail is string && data.ownerEmail.size() <= 200 &&
             data.isReadOnly is bool &&
             data.sortOrder is int &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTaskItem(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.listId is string && data.listId.size() >= 1 && data.listId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 250 &&
             data.notes is string && data.notes.size() <= 2000 &&
             data.priority in ['URGENT', 'HIGH', 'MEDIUM', 'LOW'] &&
             data.isCompleted is bool &&
             data.dueDateEpoch is int && data.dueDateEpoch >= 0 &&
             data.reminderEpoch is int && data.reminderEpoch >= 0 &&
             data.reminderSoundKey is string && data.reminderSoundKey.size() >= 1 && data.reminderSoundKey.size() <= 40 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserSettings(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.defaultSoundKey is string && data.defaultSoundKey.size() >= 1 && data.defaultSoundKey.size() <= 40 &&
             data.useDarkTheme is bool &&
             data.biometricEnabled is bool &&
             data.customCategories is list && data.customCategories.size() <= 30 &&
             (data.customCategories.size() == 0 || data.customCategories[0] is string) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/lists/{listId} {
      allow get: if isOwner(userId) && isValidId(listId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(listId) &&
                       incoming().keys().hasAll(['userId', 'title', 'iconKey', 'colorHex', 'isLocked', 'isShared', 'driveFileId', 'ownerEmail', 'isReadOnly', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'iconKey', 'colorHex', 'isLocked', 'isShared', 'driveFileId', 'ownerEmail', 'isReadOnly', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       isValidTodoList(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(listId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTodoList(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'iconKey', 'colorHex', 'isLocked', 'isShared', 'driveFileId', 'ownerEmail', 'isReadOnly', 'sortOrder', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(listId);
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(taskId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(taskId) &&
                       incoming().keys().hasAll(['userId', 'listId', 'title', 'notes', 'priority', 'isCompleted', 'dueDateEpoch', 'reminderEpoch', 'reminderSoundKey', 'category', 'updatedByEmail', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'listId', 'title', 'notes', 'priority', 'isCompleted', 'dueDateEpoch', 'reminderEpoch', 'reminderSoundKey', 'category', 'updatedByEmail', 'createdAt', 'updatedAt']) &&
                       isValidTaskItem(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(taskId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTaskItem(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['listId', 'title', 'notes', 'priority', 'isCompleted', 'dueDateEpoch', 'reminderEpoch', 'reminderSoundKey', 'category', 'updatedByEmail', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(taskId);
    }

    match /users/{userId}/settings/{settingId} {
      allow get: if isOwner(userId) && isValidId(settingId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(settingId) &&
                       incoming().keys().hasAll(['userId', 'defaultSoundKey', 'useDarkTheme', 'biometricEnabled', 'customCategories', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'defaultSoundKey', 'useDarkTheme', 'biometricEnabled', 'customCategories', 'updatedAt']) &&
                       isValidUserSettings(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(settingId) &&
                       incoming().userId == existing().userId &&
                       isValidUserSettings(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['defaultSoundKey', 'useDarkTheme', 'biometricEnabled', 'customCategories', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(settingId);
    }
  }
}
