{
  "entities": {
    "TodoList": {
      "title": "TodoList",
      "description": "A user-owned todo list stored in Firestore.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "title": { "type": "string", "description": "List title" },
        "iconKey": { "type": "string", "description": "Icon identifier" },
        "colorHex": { "type": "string", "description": "Hex color code" },
        "isLocked": { "type": "boolean", "description": "Whether biometric lock is enabled" },
        "isShared": { "type": "boolean", "description": "Whether list is shared on Google Drive" },
        "driveFileId": { "type": "string", "description": "Linked Google Drive file ID" },
        "ownerEmail": { "type": "string", "description": "Owner email address" },
        "isReadOnly": { "type": "boolean", "description": "Whether read-only" },
        "sortOrder": { "type": "integer", "description": "Display sort order" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on create" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "title", "iconKey", "colorHex", "isLocked", "isShared", "driveFileId", "ownerEmail", "isReadOnly", "sortOrder", "createdAt", "updatedAt"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "A task item belonging to a user's list.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "listId": { "type": "string", "description": "Parent list ID" },
        "title": { "type": "string", "description": "Task title" },
        "notes": { "type": "string", "description": "Optional task notes" },
        "priority": { "type": "string", "enum": ["URGENT", "HIGH", "MEDIUM", "LOW"], "description": "Task priority" },
        "isCompleted": { "type": "boolean", "description": "Completion flag" },
        "dueDateEpoch": { "type": "integer", "description": "Due date epoch millis or 0" },
        "reminderEpoch": { "type": "integer", "description": "Reminder epoch millis or 0" },
        "reminderSoundKey": { "type": "string", "description": "Alert sound key" },
        "category": { "type": "string", "description": "Task category label" },
        "updatedByEmail": { "type": "string", "description": "Last updater email" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on create" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "listId", "title", "notes", "priority", "isCompleted", "dueDateEpoch", "reminderEpoch", "reminderSoundKey", "category", "updatedByEmail", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Per-user app preferences and custom categories.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "defaultSoundKey": { "type": "string", "description": "Default reminder sound" },
        "useDarkTheme": { "type": "boolean", "description": "Dark mode preference" },
        "biometricEnabled": { "type": "boolean", "description": "Biometric lock toggle" },
        "customCategories": { "type": "array", "description": "List of category strings" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "defaultSoundKey", "useDarkTheme", "biometricEnabled", "customCategories", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/lists/{listId}": {
      "schema": { "$ref": "#/entities/TodoList" },
      "description": "User-scoped todo lists"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "User-scoped task items"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User-scoped preferences"
    }
  }
}
